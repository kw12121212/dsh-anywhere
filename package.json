{
  "name": "dsh-anywhere",
  "version": "0.0.0",
  "private": true,
  "description": "接入远程 DeepSeek harness 的桌面客户端",
  "author": "Keepwriting",
  "desktopName": "dsh-anywhere",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/renderer/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "flip-fuses": "node scripts/flip-fuses.mts",
    "dist": "node scripts/dist.mts",
    "dist:win": "node scripts/dist.mts --win",
    "dist:mac": "node scripts/dist.mts --mac",
    "dist:linux": "node scripts/dist.mts --linux"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
